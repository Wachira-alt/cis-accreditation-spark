# Copy this file to ".env" and fill in the values, then restart `vite dev`
# (Vite only reads env vars at startup).

# Browser API key — reads Drive folders shared "anyone with the link" and lists
# YouTube playlists. Optional if you rely solely on reviewer sign-in below.
# Cloud Console -> enable Google Drive API -> Credentials -> API key ->
# restrict to Drive API + your domain and localhost.
VITE_GOOGLE_API_KEY=

# OAuth Client ID — lets reviewers sign in and open folders shared privately with
# their own Google account (per-person access). Cloud Console -> OAuth consent
# screen (External, add reviewers as Test users) -> Credentials -> OAuth client ID
# (Web application) -> add your domain and http://localhost:3000 as authorised
# JavaScript origins.
VITE_GOOGLE_CLIENT_ID=
